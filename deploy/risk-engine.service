[Unit]
Description=Risk engine live risk view
After=network.target

[Service]
Environment=JAVA_HOME=/opt/jdk25
Environment=JAVA_OPTS=-Xmx160m
Environment=PORT=8081
ExecStart=/home/ubuntu/risk-engine/bin/risk-engine
Restart=on-failure
RestartSec=2
User=ubuntu

# Sandboxing. This service is reachable from the internet and writes nothing to disk — every
# valuation is computed per request and held in memory — so the whole filesystem is read-only and
# it needs no ReadWritePaths at all. `systemd-analyze security risk-engine.service` reports it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# MemoryDenyWriteExecute is deliberately absent rather than set false, so it does not get added
# later: the JVM writes JIT-compiled code and then executes it, and enabling it kills the process
# at the first compilation.
#
# Sized from the observed peak (38 MB) and the 160 MB heap, not from either alone. The point is to
# bound a runaway into a restart rather than let one tenant of a 1 GB box take the others with it.
MemoryMax=384M
TasksMax=256

[Install]
WantedBy=multi-user.target
